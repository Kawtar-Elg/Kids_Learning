# Copy this file to `keystore.properties` (DO NOT COMMIT IT) and fill your values.
#
# Recommended: keep your keystore under a non-tracked folder like `keystore/`.
# Example:
# storeFile=keystore/upload-keystore.jks

storeFile=keystore/upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD