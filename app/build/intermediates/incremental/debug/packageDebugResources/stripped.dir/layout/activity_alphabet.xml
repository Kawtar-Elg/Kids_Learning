<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_rainbow">

    <!-- Fun Curved Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_fun"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button with Circle Background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBackCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
                app:tint="@color/primary_blue"
                android:scaleType="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Fun Title with Stars -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/btnBackCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivTitleStar1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_star"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tap_letter"
                android:textSize="24sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:shadowColor="#33000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <ImageView
                android:id="@+id/ivTitleStar2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_star"
                android:layout_marginStart="12dp"
                android:contentDescription="@null" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Decorative Bubble Yellow - FLOATING -->
    <View
        android:id="@+id/bubbleYellow"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_bubble_yellow"
        android:alpha="0.6"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Decorative Star - PULSING -->
    <ImageView
        android:id="@+id/ivFloatingStar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_star"
        android:alpha="0.8"
        android:layout_marginTop="60dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="@null" />

    <!-- Fun Grid of Letters -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLetters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/item_letter" />

    <!-- Bottom Decorative Cloud - FLOATING -->
    <ImageView
        android:id="@+id/ivBottomCloud"
        android:layout_width="90dp"
        android:layout_height="55dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.4"
        android:layout_marginBottom="-15dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="@null" />

    <!-- Bottom Pink Bubble - RISING -->
    <View
        android:id="@+id/bubblePink"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/bg_bubble_pink"
        android:alpha="0.5"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Blue Bubble - RISING -->
    <View
        android:id="@+id/bubbleBlue"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/bg_bubble_blue"
        android:alpha="0.6"
        android:layout_marginBottom="80dp"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Floating Heart - BEATING -->
    <ImageView
        android:id="@+id/ivFloatingHeart"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_heart"
        android:alpha="0.7"
        android:layout_marginBottom="120dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>
