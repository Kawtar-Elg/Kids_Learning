<?xml version="1.0" encoding="utf-8"?><!-- 🎨 Color Palette - Beautiful & Kid-Friendly! -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeWidth="3dp"
    app:strokeColor="@color/accent_purple"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Color Selection Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="8dp">

            <!-- Pink -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorPink"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#FF69B4">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Red -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorRed"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#FF5252">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Orange -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorOrange"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#FF8C00">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Yellow -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorYellow"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#FFD700">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Green -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorGreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#4CAF50">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Color Selection Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Cyan -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorCyan"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#00BCD4">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Blue -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorBlue"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#2196F3">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Purple -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorPurple"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#9370DB">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Brown -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorBrown"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#8D6E63">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Black -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/colorBlack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="3dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="#212121">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
