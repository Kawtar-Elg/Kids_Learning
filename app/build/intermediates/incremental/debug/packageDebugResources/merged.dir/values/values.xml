    <string name="app_name">Kids Learning</string>
    <string name="arabic_alphabet">الحروف العربية</string>
    <string name="back">Retour</string>
    <string name="choose_language">Choisis ton alphabet</string>
    <string name="clear">Effacer</string>
    <string name="draw_letter">Trace la lettre</string>
    <string name="font_family_comic_sans" translatable="false">sans-serif</string>
    <string name="french_alphabet">Alphabet Français</string>
    <string name="repeat_sound">Répéter</string>
    <string name="start_learning">Commencer</string>
    <string name="tap_letter">Touche une lettre!</string>
    <string name="try_again">Recommence</string>
