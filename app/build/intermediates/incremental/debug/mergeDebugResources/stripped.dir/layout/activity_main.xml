<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_rainbow"
    tools:context=".ui.main.MainActivity">

    <!-- Language Switch Button - Top Left -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnLanguageCard"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="25dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/accent_purple"
        app:strokeWidth="2dp"
        app:strokeColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnLanguage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_language"
            android:scaleType="center"
            android:contentDescription="@string/content_desc_language" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Language Label -->
    <TextView
        android:id="@+id/tvLanguageLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/language_arabic"
        android:textSize="14sp"
        android:textColor="@color/accent_purple"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/btnLanguageCard"
        app:layout_constraintTop_toTopOf="@id/btnLanguageCard"
        app:layout_constraintBottom_toBottomOf="@id/btnLanguageCard" />

    <!-- Happy Sun in Top Right - ROTATING -->
    <ImageView
        android:id="@+id/ivSun"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_sun"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@null" />

    <!-- Decorative Cloud Left - FLOATING -->
    <ImageView
        android:id="@+id/ivCloudLeft"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.8"
        android:layout_marginStart="-20dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@null" />

    <!-- Decorative Cloud Middle - FLOATING SIDEWAYS -->
    <ImageView
        android:id="@+id/ivCloudMiddle"
        android:layout_width="70dp"
        android:layout_height="45dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.6"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.3"
        android:contentDescription="@null" />

    <!-- Pink Balloon Left - SWAYING -->
    <ImageView
        android:id="@+id/ivBalloon"
        android:layout_width="40dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_balloon"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="@null" />

    <!-- Floating Star 1 - PULSING -->
    <ImageView
        android:id="@+id/ivStar1"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_star"
        android:alpha="0.9"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="140dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@null" />

    <!-- Floating Star 2 - PULSING -->
    <ImageView
        android:id="@+id/ivStar2"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_star"
        android:alpha="0.7"
        android:layout_marginStart="50dp"
        android:layout_marginTop="180dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@null" />

    <!-- Logo Card - BOUNCING -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/logoCard"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginTop="60dp"
        app:cardCornerRadius="65dp"
        app:cardElevation="16dp"
        app:strokeWidth="5dp"
        app:strokeColor="@color/accent_yellow"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:src="@drawable/ic_kids_logo"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Sparkle 1 - TWINKLING -->
    <ImageView
        android:id="@+id/ivSparkle1"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_sparkle"
        android:layout_marginEnd="-8dp"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="@id/logoCard"
        app:layout_constraintTop_toTopOf="@id/logoCard"
        android:contentDescription="@null" />

    <!-- Sparkle 2 - TWINKLING -->
    <ImageView
        android:id="@+id/ivSparkle2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_sparkle"
        android:layout_marginStart="-5dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toStartOf="@id/logoCard"
        app:layout_constraintBottom_toBottomOf="@id/logoCard"
        android:contentDescription="@null" />

    <!-- Welcome Title -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/welcome_title"
        android:textSize="38sp"
        android:textColor="@color/text_fun"
        android:textStyle="bold"
        android:shadowColor="#44000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintTop_toBottomOf="@id/logoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle with stars -->
    <LinearLayout
        android:id="@+id/subtitleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivSubtitleStar1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvChoose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_language"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSubtitleStar2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_star"
            android:layout_marginStart="8dp"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- ========== BIG CIRCULAR BUTTONS SIDE BY SIDE ========== -->

    <!-- Arabic Circle Button - BOUNCING -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardArabic"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="75dp"
        app:cardElevation="16dp"
        app:strokeWidth="6dp"
        app:strokeColor="@color/white"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/subtitleLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomDecoration"
        app:layout_constraintEnd_toStartOf="@id/cardFrench"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_arabic">

            <!-- Arabic Letters -->
            <TextView
                android:id="@+id/tvArabicLetters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ا ب"
                android:textSize="36sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:shadowColor="#33000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvArabicLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvArabicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arabic_alphabet"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvArabicLetters"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Star decoration on Arabic button - PULSING -->
    <ImageView
        android:id="@+id/ivArabicStar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_star"
        android:layout_marginEnd="-5dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="@id/cardArabic"
        app:layout_constraintTop_toTopOf="@id/cardArabic"
        android:contentDescription="@null" />

    <!-- French Circle Button - BOUNCING -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFrench"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="12dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="75dp"
        app:cardElevation="16dp"
        app:strokeWidth="6dp"
        app:strokeColor="@color/white"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/subtitleLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomDecoration"
        app:layout_constraintStart_toEndOf="@id/cardArabic"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_french">

            <!-- French Letters -->
            <TextView
                android:id="@+id/tvFrenchLetters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A B C"
                android:textSize="32sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:shadowColor="#33000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvFrenchLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvFrenchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/french_alphabet"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvFrenchLetters"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Heart decoration on French button - BEATING -->
    <ImageView
        android:id="@+id/ivFrenchHeart"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_heart"
        android:layout_marginStart="-5dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="@id/cardFrench"
        app:layout_constraintTop_toTopOf="@id/cardFrench"
        android:contentDescription="@null" />

    <!-- ========== VIDEO LEARNING CIRCLE BUTTON ========== -->

    <!-- Video Circle Button - Same style as Arabic/French -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardVideos"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="75dp"
        app:cardElevation="16dp"
        app:strokeWidth="6dp"
        app:strokeColor="@color/white"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/cardArabic"
        app:layout_constraintBottom_toTopOf="@id/bottomDecoration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_circle_video">

            <ImageView
                android:id="@+id/ivVideoIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_video"
                android:contentDescription="@string/content_desc_video"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvVideoLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/tvVideoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watch_videos"
                android:textSize="14sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/ivVideoIcon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ========== BOTTOM DECORATIONS ========== -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomDecoration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.88" />

    <!-- Bottom Cloud - FLOATING -->
    <ImageView
        android:id="@+id/ivBottomCloud"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.6"
        android:layout_marginBottom="-15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@null" />

    <!-- Bottom Bubble Pink - RISING -->
    <View
        android:id="@+id/bubblePink"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:background="@drawable/bg_bubble_pink"
        android:alpha="0.7"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Bubble Yellow - RISING -->
    <View
        android:id="@+id/bubbleYellow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/bg_bubble_yellow"
        android:alpha="0.6"
        android:layout_marginBottom="70dp"
        android:layout_marginStart="35dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom Bubble Blue - RISING -->
    <View
        android:id="@+id/bubbleBlue"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_bubble_blue"
        android:alpha="0.5"
        android:layout_marginBottom="25dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
