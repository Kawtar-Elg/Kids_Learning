<?xml version="1.0" encoding="utf-8"?><!-- 🎨 Color Palette - Simple circles with colors only -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <!-- Color Selection Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="6dp">

        <!-- Pink -->
        <View
            android:id="@+id/colorPink"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#FF69B4" />

        <!-- Red -->
        <View
            android:id="@+id/colorRed"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#FF5252" />

        <!-- Orange -->
        <View
            android:id="@+id/colorOrange"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#FF8C00" />

        <!-- Yellow -->
        <View
            android:id="@+id/colorYellow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#FFD700" />

        <!-- Green -->
        <View
            android:id="@+id/colorGreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#4CAF50" />

    </LinearLayout>

    <!-- Color Selection Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Cyan -->
        <View
            android:id="@+id/colorCyan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#00BCD4" />

        <!-- Blue -->
        <View
            android:id="@+id/colorBlue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#2196F3" />

        <!-- Purple -->
        <View
            android:id="@+id/colorPurple"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#9370DB" />

        <!-- Brown -->
        <View
            android:id="@+id/colorBrown"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#8D6E63" />

        <!-- Black -->
        <View
            android:id="@+id/colorBlack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="5dp"
            android:background="@drawable/circle_shape"
            android:backgroundTint="#212121" />

    </LinearLayout>

</LinearLayout>
