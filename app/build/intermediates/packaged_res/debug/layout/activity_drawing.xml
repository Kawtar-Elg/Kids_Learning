<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_rainbow">

    <!-- Fun Curved Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_fun"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button with Circle Background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBackCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
                app:tint="@color/primary_blue"
                android:scaleType="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Big Letter Display in Center - BOUNCING -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/letterDisplayCard"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/accent_yellow"
            app:strokeWidth="3dp"
            app:strokeColor="@color/white"
            app:layout_constraintStart_toEndOf="@id/btnBackCard"
            app:layout_constraintEnd_toStartOf="@id/btnRepeatCard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvLetterDisplay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textSize="32sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:shadowColor="#33000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Sound Button with Circle Background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRepeatCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/accent_pink"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sound"
                android:contentDescription="@string/repeat_sound"
                app:tint="@color/white"
                android:scaleType="center" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Fun Instruction Text -->
    <LinearLayout
        android:id="@+id/instructionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivSparkle1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_sparkle"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/draw_letter"
            android:textSize="22sp"
            android:textColor="@color/text_fun"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSparkle2"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_sparkle"
            android:layout_marginStart="8dp"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- Decorative Yellow Bubble - FLOATING -->
    <View
        android:id="@+id/bubbleYellow"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_bubble_yellow"
        android:alpha="0.6"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/instructionLayout"
        android:layout_marginTop="10dp" />

    <!-- Fun Drawing Area Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDrawing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeWidth="4dp"
        app:strokeColor="@color/accent_cyan"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/instructionLayout"
        app:layout_constraintBottom_toTopOf="@id/btnClear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">

        <com.kidslearning.app.utils.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Decorative Pink Bubble - RISING -->
    <View
        android:id="@+id/bubblePink"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_bubble_pink"
        android:alpha="0.5"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardDrawing"
        android:layout_marginTop="60dp" />

    <!-- Fun Clear Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClear"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/clear"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_orange"
        app:icon="@drawable/ic_clear"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        app:cornerRadius="30dp"
        app:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Cloud Decoration - FLOATING -->
    <ImageView
        android:id="@+id/ivBottomCloud"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.4"
        android:layout_marginBottom="-10dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="@null" />

    <!-- Bottom Star Decoration - PULSING -->
    <ImageView
        android:id="@+id/ivBottomStar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_star"
        android:alpha="0.7"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnClear"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@null" />

    <!-- Floating Heart - BEATING -->
    <ImageView
        android:id="@+id/ivFloatingHeart"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_heart"
        android:alpha="0.6"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="100dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>
