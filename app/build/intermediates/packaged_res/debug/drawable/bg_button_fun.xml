<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="#FF8FAB" android:endColor="#FF6B9D" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90" android:startColor="#FFB6C1" android:endColor="#FF8FAB" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</selector>
