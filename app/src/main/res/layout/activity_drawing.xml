<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_rainbow">

    <!-- ✨ UPGRADED Fun Curved Toolbar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_fun"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:elevation="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ⬅️ Back Button with Circle Background - BIGGER! -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBackCard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="3dp"
            app:strokeColor="@color/primary_blue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
                app:tint="@color/primary_blue"
                android:scaleType="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 🔤 BIG Letter Display in Center - BOUNCING & GLOWING! -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/letterDisplayCard"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/accent_yellow"
            app:strokeWidth="4dp"
            app:strokeColor="@color/white"
            app:layout_constraintStart_toEndOf="@id/btnBackCard"
            app:layout_constraintEnd_toStartOf="@id/btnRepeatCard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvLetterDisplay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A"
                android:textSize="42sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:shadowColor="#66000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 🎵 Music Button with Circle Background - BIGGER! -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnMusicCard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/accent_cyan"
            app:strokeWidth="3dp"
            app:strokeColor="@color/white"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@id/btnRepeatCard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnMusic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sound"
                android:contentDescription="@string/toggle_music"
                app:tint="@color/white"
                android:scaleType="center" />

        </com.google.android.material.card.MaterialCardView>

        <!-- 🔊 Sound Button with Circle Background - BIGGER! -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnRepeatCard"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/accent_pink"
            app:strokeWidth="3dp"
            app:strokeColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sound"
                android:contentDescription="@string/repeat_sound"
                app:tint="@color/white"
                android:scaleType="center" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ✨ Fun Instruction Text - UPGRADED! -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/instructionCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="3dp"
        app:strokeColor="@color/accent_purple"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:id="@+id/instructionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivSparkle1"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_sparkle"
            android:layout_marginEnd="10dp"
            app:tint="@color/accent_yellow"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/draw_letter"
            android:textSize="24sp"
            android:textColor="@color/accent_purple"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivSparkle2"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_sparkle"
            android:layout_marginStart="10dp"
            app:tint="@color/accent_yellow"
            android:contentDescription="@null" />

    </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 🟡 Decorative Yellow Bubble - FLOATING & BIGGER! -->
    <View
        android:id="@+id/bubbleYellow"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_bubble_yellow"
        android:alpha="0.7"
        android:layout_marginStart="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/instructionCard"
        android:layout_marginTop="16dp" />

    <!-- 🎨 UPGRADED Drawing Area Card - BIGGER & MORE COLORFUL! -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDrawing"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:strokeWidth="6dp"
        app:strokeColor="@color/accent_purple"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/instructionCard"
        app:layout_constraintBottom_toTopOf="@id/colorPaletteLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp">

        <com.kidslearning.app.utils.DrawingView
            android:id="@+id/drawingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- 🩷 Decorative Pink Bubble - RISING & BIGGER! -->
    <View
        android:id="@+id/bubblePink"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_bubble_pink"
        android:alpha="0.6"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardDrawing"
        android:layout_marginTop="48dp" />

    <!-- 🎨 Color Palette - Include the palette layout -->
    <include
        android:id="@+id/colorPaletteLayout"
        layout="@layout/color_palette"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/btnActionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Action Buttons Layout (Undo, Redo, Clear) -->
    <LinearLayout
        android:id="@+id/btnActionLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Undo Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="↶"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_blue"
            app:cornerRadius="30dp"
            app:elevation="8dp"
            app:strokeWidth="3dp"
            app:strokeColor="@color/white" />

        <!-- Clear Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1.5"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="@string/clear"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/accent_orange"
            app:icon="@drawable/ic_clear"
            app:iconGravity="textStart"
            app:iconTint="@color/white"
            app:iconSize="24dp"
            app:cornerRadius="34dp"
            app:elevation="12dp"
            app:strokeWidth="4dp"
            app:strokeColor="@color/white" />

        <!-- Redo Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRedo"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="↷"
            android:textSize="32sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_blue"
            app:cornerRadius="30dp"
            app:elevation="8dp"
            app:strokeWidth="3dp"
            app:strokeColor="@color/white" />

    </LinearLayout>

    <!-- ☁️ Bottom Cloud Decoration - FLOATING & BIGGER! -->
    <ImageView
        android:id="@+id/ivBottomCloud"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_cloud"
        android:alpha="0.5"
        android:layout_marginBottom="-10dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="@null" />

    <!-- ⭐ Bottom Star Decoration - PULSING & BIGGER! -->
    <ImageView
        android:id="@+id/ivBottomStar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_star"
        android:alpha="0.8"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="20dp"
        app:tint="@color/accent_yellow"
        app:layout_constraintBottom_toTopOf="@id/colorPaletteLayout"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="@null" />

    <!-- ❤️ Floating Heart - BEATING & BIGGER! -->
    <ImageView
        android:id="@+id/ivFloatingHeart"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_heart"
        android:alpha="0.7"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="110dp"
        app:tint="@color/accent_pink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>
