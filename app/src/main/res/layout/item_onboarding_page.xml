<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- Floating bubble decoration top -->
    <View
        android:id="@+id/bubbleTop"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_bubble_pink"
        android:alpha="0.6"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Floating star decoration -->
    <ImageView
        android:id="@+id/ivFloatingStar"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_star"
        android:alpha="0.7"
        android:layout_marginTop="100dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="@null" />

    <!-- Lottie Animation Container - Big and Circular -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/animationCard"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="40dp"
        app:cardCornerRadius="125dp"
        app:cardElevation="20dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="6dp"
        app:strokeColor="@color/accent_yellow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnimation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Sparkle decorations around animation -->
    <ImageView
        android:id="@+id/ivSparkle1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_sparkle"
        android:layout_marginEnd="-12dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="@id/animationCard"
        app:layout_constraintTop_toTopOf="@id/animationCard"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/ivSparkle2"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_sparkle"
        android:layout_marginStart="-8dp"
        android:layout_marginBottom="35dp"
        app:layout_constraintStart_toStartOf="@id/animationCard"
        app:layout_constraintBottom_toBottomOf="@id/animationCard"
        android:contentDescription="@null" />

    <!-- Small star near animation -->
    <ImageView
        android:id="@+id/ivMiniStar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_star"
        android:layout_marginStart="-5dp"
        android:layout_marginTop="60dp"
        app:layout_constraintStart_toStartOf="@id/animationCard"
        app:layout_constraintTop_toTopOf="@id/animationCard"
        android:contentDescription="@null" />

    <!-- Title - Fun and Bold -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Welcome!"
        android:textSize="34sp"
        android:textColor="@color/text_fun"
        android:textStyle="bold"
        android:gravity="center"
        android:shadowColor="#33000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        app:layout_constraintTop_toBottomOf="@id/animationCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description with hearts -->
    <LinearLayout
        android:id="@+id/descriptionLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivHeart1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_heart"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Learn and have fun!"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/ivHeart2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_heart"
            android:layout_marginStart="10dp"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- Fun animal icon row - Animated -->
    <LinearLayout
        android:id="@+id/emojiLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/descriptionLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivIcon1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_paw"
            android:layout_marginEnd="20dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/ivIcon2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_fish"
            android:layout_marginEnd="20dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/ivIcon3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_butterfly"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- Bottom floating bubble -->
    <View
        android:id="@+id/bubbleBottom"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_bubble_yellow"
        android:alpha="0.5"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
